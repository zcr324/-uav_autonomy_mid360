# 构建产物
build/
devel/
install/
logs/

# 日志与临时文件
*.log
*.ulg
__pycache__/
*.pyc
.vscode/
*.backup_*

# 外部依赖仓库（由 tools/setup_deps.sh 拉取）
repos/*
!repos/ego-planner-team/

# ego-planner 包符号链接
src/planning/
src/plan_env
src/path_searching
src/bspline_opt
src/traj_utils
src/plan_manage
src/quadrotor_msgs

# LIO 运行期产物（PCD/日志）
src/lio/FAST_LIO/Log/
*.pcd

/integration/baseline_ws/
/integration/logs/
/build_integration/
/devel_integration/

!src/plan_env
!src/path_searching
!src/bspline_opt
!src/traj_utils
!src/plan_manage
!src/quadrotor_msgs

# Generated experiment data; keep summaries/configuration in source control.
/integration/runs/
/integration/replays/
/integration/current_run.txt
/integration/experiment.lock

# Local repair snapshots, one-off workers and PID files are not deliverables.
/integration/final_checks_20261022/*
!/integration/final_checks_20261022/final_checks.json
!/integration/final_checks_20261022/original_source_check.json
!/integration/final_checks_20261022/experiment_summary.json

# Deliberately version the small sensor-derived map examples.
!/docs/results/**/*.pcd
