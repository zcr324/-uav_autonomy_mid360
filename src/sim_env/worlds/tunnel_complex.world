    <!-- 支路1顶板 -->
    <model name="branch1_ceiling">
      <static>true</static>
      <pose>25 -5.1 2.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>2.5 7.2 0.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
