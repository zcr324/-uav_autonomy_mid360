    <!-- ===================== -->
    <!-- 一些障碍物（都放在通道内部） -->
    <!-- ===================== -->

    <!-- 主隧道左侧：绿色小箱体 -->
    <model name="obstacle_main_left_small">
      <static>true</static>
      <pose>6 1.25 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.8</size></box>
          </geometry>
