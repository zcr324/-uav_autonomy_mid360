            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 主隧道右侧：蓝色圆柱 -->
    <model name="obstacle_main_right_cylinder">
      <static>true</static>
      <pose>21 0.0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 支路右侧：橙色小方柱 -->
    <model name="obstacle_branch_right_small">
      <static>true</static>
      <pose>16.0 7.8 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
