    </model>
    <!-- 动态障碍物 -->
    <!-- 长宽为0.6m，高为1.0m的红色长方体，在-1.2m到1.2m间移动，用move.py程序调控 -->
    <model name="dynamic_obstacle">
      <pose>15 0.0 0.5 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.1133</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.1133</iyy><iyz>0</iyz>
            <izz>0.06</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.6 0.6 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.6 0.6 1.0</size></box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>