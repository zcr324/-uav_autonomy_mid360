<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="connected_branch_corridor_world">
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.70 0.78 0.86 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <!--
      Corridor definition:
      - All corridor inner width: 3 m
      - Wall height: 2 m
      - Ceiling bottom: z = 2.0 m
      - Main road: (0,0,0) to (100,0,0), direction +X
      - Left branches: +Y direction at x=20 and x=85
      - Right branch UAV route centerline: (0,0,1) -> (60,0,1) -> (60,-15,1) -> (69,-15,1) -> (69,-25,1)
      - Green route-marker spheres have been removed.
      - Wall and ceiling boxes are generated from the connected corridor footprint so the right branch and turns are closed cleanly.
    -->

