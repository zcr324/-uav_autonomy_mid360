<launch>
  <arg name="estimator" default="gps"/>
  <arg name="px4_workdir" default="$(env UAV_WS)/integration/logs/px4_integrated"/>
  <arg name="gui" default="true" />
  <arg name="world" default="$(find sim_env)/worlds/structured_px4.world" />
  <arg name="x" default="20" /><arg name="y" default="4" /><arg name="z" default="0.5" />
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)" /><arg name="gui" value="$(arg gui)" />
  </include>
  <group ns="iris_0">
    <env name="UAV_ESTIMATOR" value="$(arg estimator)"/>
    <env name="PX4_SIM_MODEL" value="iris" /><env name="PX4_ESTIMATOR" value="ekf2" />
    <param name="model_description" textfile="$(find sim_env)/models/iris_mid360_fl2/iris_mid360_fl2.sdf" />
    <node name="sitl_0" pkg="px4" type="px4" launch-prefix="python3 $(env UAV_WS)/tools/px4_profile_start.py" output="screen" args="$(find px4)/build/px4_sitl_default/etc -s etc/init.d-posix/rcS -i 0 -w $(arg px4_workdir) -d" />
    <node name="spawn" pkg="gazebo_ros" type="spawn_model" output="screen" args="-sdf -param model_description -model iris_0 -x $(arg x) -y $(arg y) -z $(arg z)" />
    <include file="$(find mavros)/launch/px4.launch">
      <arg name="fcu_url" value="udp://:24540@localhost:34580" />
      <arg name="gcs_url" value="" /><arg name="tgt_system" value="1" /><arg name="tgt_component" value="1" />
    </include>
  </group>
</launch>
