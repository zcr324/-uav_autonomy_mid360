<?xml version="1.0"?>
<package format="2">
  <name>mission</name>
  <version>0.0.1</version>
  <description>Mission layer: XTDrone-style communication bridge (py3), takeoff sequence, and waypoint mission executor for route following.</description>
  <maintainer email="zcr@todo.todo">zcr</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
</package>
