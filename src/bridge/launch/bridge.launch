<launch>
  <arg name="drone_id" default="0"/><arg name="use_reloc" default="false"/>
  <arg name="init_x" default="0"/><arg name="init_y" default="0"/><arg name="init_z" default="0.055"/>
  <arg name="init_yaw" default="0"/><arg name="start_control" default="false"/>
  <node pkg="bridge" type="lio_transfer.py" name="lio_transfer" output="screen">
    <param name="drone_id" value="$(arg drone_id)"/><param name="use_reloc" value="$(arg use_reloc)"/>
    <param name="init_x" value="$(arg init_x)"/><param name="init_y" value="$(arg init_y)"/>
    <param name="init_z" value="$(arg init_z)"/><param name="init_yaw" value="$(arg init_yaw)"/>
  </node>
  <node if="$(arg start_control)" pkg="bridge" type="control_transfer.py" name="control_transfer" output="screen">
    <param name="drone_id" value="$(arg drone_id)"/><param name="output" value="xtdrone"/>
    <param name="enu_to_ned" value="false"/>
  </node>
</launch>
